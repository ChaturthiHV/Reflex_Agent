# Copy this file to .env and fill in what you have.
# ReflexAgent runs in offline mock-LLM mode automatically if both are absent.

GROQ_API_KEY=
GROQ_MODEL_PRIMARY=openai/gpt-oss-120b
GROQ_MODEL_SECONDARY=openai/gpt-oss-20b

GOOGLE_API_KEY=
GEMINI_MODEL=gemini-1.5-flash-8b

# Loop behaviour
REFLEXAGENT_MAX_ATTEMPTS=4
REFLEXAGENT_CONFIDENCE_FLOOR=0.4
